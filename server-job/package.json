{
  "name": "server-job",
  "version": "1.0.0",
  "description": "学管系统 · 就业管理 后端服务（Express + TypeScript）",
  "main": "dist/app.js",
  "scripts": {
    "predev": "cd ../shared-types && npm run build",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "migrate": "node scripts/migrate-all.mjs",
    "migrate:job": "knex migrate:latest",
    "migrate:edu": "knex migrate:latest --env edu",
    "migrate:class": "knex migrate:latest --env class && knex migrate:latest --env class-common",
    "migrate:class-jh": "knex migrate:latest --env class-jh",
    "migrate:consult": "node scripts/fix-consult-columns.mjs",
    "fix:consult": "node scripts/fix-consult-columns.mjs",
    "fix:fee-name": "node scripts/fix-teach-fee-item-name.mjs",
    "fix:consult-state": "node scripts/repair-consult-state.mjs",
    "fix:trial-start": "node scripts/repair-trial-start.mjs",
    "fix:refund-state": "node scripts/repair-refund-state.mjs",
    "fix:supp-bills": "node scripts/repair-supplement-bills.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:regen-perm": "node scripts/regen-init-perm.cjs",
    "db:verify-init": "node scripts/verify-init-sql.cjs",
    "seed:perm-tree": "tsx scripts/seed-perm-tree.ts",
    "seed:perm-tree:apply": "tsx scripts/seed-perm-tree.ts --apply",
    "export:role-defaults": "tsx scripts/export-role-defaults.ts",
    "export:role-defaults:write": "tsx scripts/export-role-defaults.ts --write",
    "migrate:list": "knex migrate:list",
    "migrate:rollback": "knex migrate:rollback",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:clean": "node scripts/seed-demo.mjs clean",
    "seed:portal": "node scripts/seed-portal-accounts.mjs",
    "seed:portal:clean": "node scripts/seed-portal-accounts.mjs clean",
    "seed:class-jh": "node scripts/seed-class-jh-demo.js",
    "seed:class-job": "node scripts/seed-class-job-demo.mjs",
    "seed:all": "node scripts/seed-all-demo.mjs && npm run uni:migrate",
    "seed:all:dry": "node scripts/seed-all-demo.mjs --dry",
    "seed:teaching": "node scripts/seed-teaching-demo.mjs",
    "seed:teaching:dry": "node scripts/seed-teaching-demo.mjs --dry",
    "seed:students": "node scripts/seed-teaching-students.mjs",
    "seed:students:dry": "node scripts/seed-teaching-students.mjs --dry",
    "seed:fee-dept": "npx tsx scripts/seed-fee-dept-demo.mts",
    "check:deploy": "node scripts/_check-deploy-prereq.mjs",
    "fix:perm": "node scripts/fix-perm-accounts.mjs",
    "seed:perm-pages": "tsx scripts/seed-perm-pages.ts",
    "check:action-overlay": "tsx scripts/check-action-overlay.ts",
    "uni:migrate:plan": "tsx scripts/uni-migrate.ts --plan",
    "uni:migrate": "tsx scripts/uni-migrate.ts --run",
    "uni:migrate:verify": "tsx scripts/uni-migrate.ts --verify",
    "db:schema-diff": "node scripts/db-schema-diff.mjs",
    "id:audit": "node scripts/id-audit.mjs",
    "id:unify": "node scripts/unify-user-ids.mjs",
    "id:unify:apply": "node scripts/unify-user-ids.mjs --apply",
    "fix:perm-scope": "tsx scripts/fix-role-perm-scope.ts",
    "fix:perm-consistency": "tsx scripts/fix-perm-consistency.ts",
    "fix:perm-consistency:apply": "tsx scripts/fix-perm-consistency.ts --apply",
    "sync:page-actions": "tsx scripts/sync-role-page-actions.ts",
    "sync:page-actions:apply": "tsx scripts/sync-role-page-actions.ts --apply",
    "sync:perm-tree": "tsx scripts/sync-perm-tree-actions.ts",
    "sync:perm-tree:apply": "tsx scripts/sync-perm-tree-actions.ts --apply",
    "audit:perm": "node ../tools/_audit_perm_all.mjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.4.0",
    "mysql2": "^3.9.7",
    "shared-types": "file:../shared-types",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
